ejes queden perfectamente explícitas, especificando qué variable va en cada eje y sus unidades física
% Graficación formal de Magnitud de Impedancia |Z| en función de f
% Variable Independiente (Eje X): Frecuencia f (Hz)
% Variable Dependiente (Eje Y): Magnitud de Impedancia |Z| (Ohms)
% =========================================================================

clear; clc; close all;

%% 1. Definición de los vectores de datos (30 pares experimentales)
f = [100, 120, 145, 170, 200, 235, 270, 310, 355, 405, ...
     460, 520, 585, 655, 730, 810, 895, 985, 1080, 1180, ...
     1290, 1410, 1540, 1680, 1830, 1990, 2160, 2340, 2530, 2730];

Z_mag = [152.3, 149.1, 146.8, 144.9, 142.0, 139.5, 137.9, 136.1, 134.8, 133.6, ...
         132.7, 131.9, 131.4, 131.1, 130.9, 131.0, 131.3, 131.9, 132.7, 133.8, ...
         135.2, 136.9, 138.9, 141.1, 143.5, 146.1, 149.0, 152.2, 155.6, 159.2];

%% 2. Identificación del mínimo tabulado
[min_Z, idx_min] = min(Z_mag);
f_min_estimada = f(idx_min);

fprintf('--- Análisis Exploratorio Inicial ---\n');
fprintf('Mínimo detectado en los datos de laboratorio:\n');
fprintf('Eje X (Frecuencia): %d Hz\n', f_min_estimada);
fprintf('Eje Y (Impedancia): %.1f Ohm\n\n', min_Z);

%% 3. Creación y personalización de la gráfica
figure('Color', [1 1 1]); % Fondo blanco formal para el reporte
hold on;

% Línea de tendencia suavizada usando un spline nativo (solo para guía visual)
f_fina = linspace(min(f), max(f), 1000);
Z_suave = spline(f, Z_mag, f_fina);
plot(f_fina, Z_suave, 'Color', [0.6 0.6 0.6], 'LineWidth', 1.2, 'LineStyle', '--', ...
     'DisplayName', 'Curva de tendencia estimada');

% Puntos experimentales reales medidos
plot(f, Z_mag, 'o', 'MarkerFaceColor', [0 0.4470 0.7410], 'MarkerEdgeColor', 'k', ...
     'MarkerSize', 6, 'LineWidth', 0.8, 'DisplayName', 'Datos medidos (|Z|_i)');

% Marcador destacado para el punto mínimo experimental
plot(f_min_estimada, min_Z, 's', 'MarkerFaceColor', [0.8500 0.3250 0.0980], ...
     'MarkerEdgeColor', 'k', 'MarkerSize', 9, 'LineWidth', 1.2, ...
     'DisplayName', sprintf('Mínimo aproximado (~%d Hz)', f_min_estimada));

%% 4. Configuración estricta de Etiquetas y Leyendas (Evita confusiones)
title('Análisis Exploratorio: Magnitud de Impedancia en Función de la Frecuencia', 'FontSize', 12);

% Variable Independiente (Causa / Estímulo controlado)
xlabel('Eje X: Frecuencia de excitación f (Hz)', 'FontSize', 11, 'FontWeight', 'bold');

% Variable Dependiente (Efecto / Respuesta del tejido)
ylabel('Eje Y: Magnitud de Impedancia |Z| (\Omega)', 'FontSize', 11, 'FontWeight', 'bold');

%% 5. Ajustes finales de visualización
grid on;
set(gca, 'GridLineStyle', ':', 'GridAlpha', 0.5); % Rejilla tenue de ingeniería
legend('Location', 'northeast', 'FontSize', 10);

% Límites de los ejes para enmarcar la forma de "U" de manera simétrica
xlim([0, 2900]);
ylim([125, 165]);

hold off;